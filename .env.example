# Copie para .env (na raiz para o docker compose, ou em backend/ para rodar a API local).
# NUNCA versione o .env real.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://semeando:semeando@localhost:5433/semeando
SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Financeiro: "fake" (MVP) ou "cora" (stub, integração futura)
PAYMENT_GATEWAY=fake
PAYMENT_WEBHOOK_SECRET=troque-este-segredo

# Assistente de IA: sem chave, o sistema usa o FakeLLM (respostas fixas, funciona offline)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
